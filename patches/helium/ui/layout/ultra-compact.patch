+          : nullptr;
+  if (!active_tab_observer_) {
+    active_tab_observer_ = std::make_unique<ActiveTabObserver>(this);
+  }
+  active_tab_observer_->Observe(tab_view);
+
+  Tab* const tab = views::AsViewClass<Tab>(tab_view);
+  if (!tab || !tab->GetVisible()) {
+    // The active tab can be hidden, e.g. when it does not fit in the tab strip.
+    // Keep the location bar usable at the end of the tab strip, where hidden
+    // tabs would be.
+    const views::View* const tab_strip =
+        tab_strip_region_view_->GetTabStripView();
+    const int tab_strip_right =
+        tab_strip_region_view_->x() +
+        (tab_strip ? tab_strip->bounds().right()
+                   : tab_strip_region_view_->width());
+    const int location_bar_width =
+        std::min(tab_strip_right - tab_strip_region_view_->x(),
+                 kPreferredCompactWidth);
+    const int location_bar_height =
+        GetLayoutConstant(LayoutConstant::kLocationBarHeight);
+    location_bar_view_->SetBounds(tab_strip_right - location_bar_width,
+                                  (height() - location_bar_height) / 2,
+                                  location_bar_width, location_bar_height);
+    return;
+  }
+
+  // Cover the visible tab shape rather than the full tab bounds, which
+  // overlap the neighboring tabs.
+  gfx::RectF bounds = gfx::SkRectToRectF(
+      tab->tab_style_views()
+          ->GetPath(TabStyle::PathType::kHighlight, /*scale=*/1.0f,
+                    {.render_units = TabStyle::RenderUnits::kDips})
+          .getBounds());
+  views::View::ConvertRectToTarget(tab, this, &bounds);
+  location_bar_view_->SetBoundsRect(
+      GetMirroredRect(gfx::ToEnclosingRect(bounds)));
+}
