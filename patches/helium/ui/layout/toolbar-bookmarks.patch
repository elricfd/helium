+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/window_open_disposition_utils.h"
+#include "ui/events/event.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/controls/button/menu_button_controller.h"
+#include "ui/views/controls/menu/menu_types.h"
+#include "ui/views/layout/flex_layout.h"
+#include "ui/views/view_class_properties.h"
+
+using bookmarks::BookmarkNode;
+
+ToolbarBookmarksContainer::ToolbarBookmarksContainer(
+    BrowserWindowInterface* browser)
+    : browser_(browser),
+      service_(BookmarkMergedSurfaceServiceFactory::GetForProfile(
+          browser->GetProfile())) {
+  layout_ = SetLayoutManager(std::make_unique<views::FlexLayout>());
+  layout_->SetCrossAxisAlignment(views::LayoutAlignment::kCenter)
+      .SetCollapseMargins(true)
+      .SetIgnoreDefaultMainAxisMargins(true)
+      .SetDefault(views::kMarginsKey,
+                  gfx::Insets::VH(0, GetLayoutConstant(
+                                         LayoutConstant::kToolbarElementPadding)))
+      .SetDefault(views::kFlexBehaviorKey,
+                  views::FlexSpecification(
+                      views::MinimumFlexSizeRule::kPreferredSnapToZero,
+                      views::MaximumFlexSizeRule::kPreferred));
+
+  GetViewAccessibility().SetRole(ax::mojom::Role::kGroup);
+  GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_BOOKMARK_BAR_FOLDER_NAME));
+
+  if (service_) {
+    service_observation_.Observe(service_.get());
+    if (service_->loaded()) {
+      Rebuild();
+    }
+  }
+}
+
+ToolbarBookmarksContainer::~ToolbarBookmarksContainer() = default;
+
+views::FlexRule ToolbarBookmarksContainer::GetFlexRule() const {
+  return layout_->GetDefaultFlexRule();
+}
+
+void ToolbarBookmarksContainer::BookmarkMergedSurfaceServiceLoaded() {
+  Rebuild();
+}
+
+void ToolbarBookmarksContainer::BookmarkNodeAdded(
+    const BookmarkParentFolder& parent,
+    size_t index) {
+  RebuildIfBar(parent);
+}
+
+void ToolbarBookmarksContainer::BookmarkNodesRemoved(
+    const BookmarkParentFolder& parent,
+    const base::flat_set<const BookmarkNode*>& nodes) {
+  RebuildIfBar(parent);
+}
+
+void ToolbarBookmarksContainer::BookmarkNodeMoved(
+    const BookmarkParentFolder& old_parent,
+    size_t old_index,
+    const BookmarkParentFolder& new_parent,
+    size_t new_index) {
+  if (old_parent == BookmarkParentFolder::BookmarkBarFolder() ||
+      new_parent == BookmarkParentFolder::BookmarkBarFolder()) {
+    Rebuild();
+  }
+}
+
+void ToolbarBookmarksContainer::BookmarkNodeChanged(const BookmarkNode* node) {
+  RebuildIfInBar(node);
+}
+
+void ToolbarBookmarksContainer::BookmarkNodeFaviconChanged(
+    const BookmarkNode* node) {
+  RebuildIfInBar(node);
+}
+
+void ToolbarBookmarksContainer::BookmarkParentFolderChildrenReordered(
+    const BookmarkParentFolder& folder) {
+  RebuildIfBar(folder);
+}
+
+void ToolbarBookmarksContainer::BookmarkAllUserNodesRemoved() {
+  Rebuild();
+}
+
+void ToolbarBookmarksContainer::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  // Buttons are the only children, in bookmarks bar order.
+  const std::optional<size_t> index = GetIndexOf(source);
+  if (!index) {
+    return;
+  }
+
+  const std::vector<raw_ptr<const BookmarkNode, VectorExperimental>> nodes = {
+      service_->GetNodeAtIndex(BookmarkParentFolder::BookmarkBarFolder(),
+                               *index)};
+  // ponytail: paste stays disabled; enabling it needs the async clipboard
+  // check from BookmarkBarView::ShowContextMenuForViewImpl.
+  context_menu_ = std::make_unique<BookmarkContextMenu>(
+      GetWidget(), browser_, browser_->GetProfile(),
+      BookmarkLaunchLocation::kAttachedBar, nodes, /*close_on_remove=*/true,
+      /*can_paste=*/false);
+  context_menu_->RunMenuAt(point, source_type);
+}
+
+void ToolbarBookmarksContainer::Rebuild() {
+  // ponytail: rebuilds every button on any bookmarks bar change, update
+  // single buttons if bars with many items make this slow.
+  RemoveAllChildViews();
+  const BookmarkParentFolder bar = BookmarkParentFolder::BookmarkBarFolder();
+  for (size_t i = 0; i < service_->GetChildrenCount(bar); ++i) {
+    AddChildView(CreateButton(service_->GetNodeAtIndex(bar, i)));
+  }
+  PreferredSizeChanged();
+}
+
+void ToolbarBookmarksContainer::RebuildIfBar(
+    const BookmarkParentFolder& folder) {
+  if (folder == BookmarkParentFolder::BookmarkBarFolder()) {
+    Rebuild();
+  }
+}
+
+void ToolbarBookmarksContainer::RebuildIfInBar(const BookmarkNode* node) {
+  if (BookmarkParentFolder::BookmarkBarFolder().HasDirectChildNode(node)) {
+    Rebuild();
+  }
+}
+
+std::unique_ptr<views::Button> ToolbarBookmarksContainer::CreateButton(
+    const BookmarkNode* node) {
+  auto button = std::make_unique<ToolbarButton>();
+  if (node->is_url()) {
+    button->SetCallback(
+        base::BindRepeating(&ToolbarBookmarksContainer::OpenBookmark,
+                            base::Unretained(this), node));
+    button->SetTriggerableEventFlags(ui::EF_LEFT_MOUSE_BUTTON |
+                                     ui::EF_MIDDLE_MOUSE_BUTTON);
+    const gfx::Image& favicon = service_->bookmark_model()->GetFavicon(node);
+    button->SetImageModel(views::Button::STATE_NORMAL,
+                          favicon.IsEmpty()
+                              ? favicon::GetDefaultFaviconModel(kColorToolbar)
+                              : ui::ImageModel::FromImage(favicon));
+  } else {
+    button->SetButtonController(std::make_unique<views::MenuButtonController>(
+        button.get(),
+        base::BindRepeating(&ToolbarBookmarksContainer::ShowFolderMenu,
+                            base::Unretained(this), button.get(), node),
+        std::make_unique<views::Button::DefaultButtonControllerDelegate>(
+            button.get())));
+    button->SetImageModel(
+        views::Button::STATE_NORMAL,
+        chrome::GetBookmarkFolderIcon(chrome::BookmarkFolderIconType::kNormal,
+                                      kColorToolbarButtonIcon));
+  }
+
+  const std::u16string title =
+      node->GetTitle().empty() ? base::UTF8ToUTF16(node->url().spec())
+                               : std::u16string(node->GetTitle());
+  button->SetTooltipText(title);
+  button->GetViewAccessibility().SetName(title);
+
+  const int size = GetLayoutConstant(LayoutConstant::kToolbarButtonHeight);
+  button->SetPreferredSize(gfx::Size(size, size));
+  button->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  button->SetFlipCanvasOnPaintForRTLUI(false);
+  button->set_context_menu_controller(this);
+  return button;
+}
+
+void ToolbarBookmarksContainer::OpenBookmark(const BookmarkNode* node,
+                                             const ui::Event& event) {
+  bookmarks::OpenAllIfAllowed(browser_, {node},
+                              ui::DispositionFromEventFlags(event.flags()));
+}
+
+void ToolbarBookmarksContainer::ShowFolderMenu(views::Button* button,
+                                               const BookmarkNode* folder) {
+  // Deletes itself when the menu closes.
+  auto* menu = new BookmarkMenuController(
+      browser_, GetWidget(), BookmarkParentFolder::FromFolderNode(folder),
+      /*start_child_index=*/0, /*for_drop=*/false);
+  menu->RunMenuAt(
+      button,
+      static_cast<views::MenuButtonController*>(button->button_controller()),
+      views::MenuAnchorPosition::kTopRight);
+}
