+
+// Shows the bookmarks bar items as icon-only buttons in the toolbar. Folders
+// open the bookmark menu. Trailing items are dropped when out of room.
+class ToolbarBookmarksContainer : public views::View,
+                                  public views::ContextMenuController,
+                                  public BookmarkMergedSurfaceServiceObserver {
+  METADATA_HEADER(ToolbarBookmarksContainer, views::View)
+
+ public:
+  explicit ToolbarBookmarksContainer(BrowserWindowInterface* browser);
+  ToolbarBookmarksContainer(const ToolbarBookmarksContainer&) = delete;
+  ToolbarBookmarksContainer& operator=(const ToolbarBookmarksContainer&) =
+      delete;
+  ~ToolbarBookmarksContainer() override;
+
+  // Flex rule for the toolbar that shrinks by dropping trailing items.
+  views::FlexRule GetFlexRule() const;
+
+  // BookmarkMergedSurfaceServiceObserver:
+  void BookmarkMergedSurfaceServiceLoaded() override;
+  void BookmarkNodeAdded(const BookmarkParentFolder& parent,
+                         size_t index) override;
+  void BookmarkNodesRemoved(
+      const BookmarkParentFolder& parent,
+      const base::flat_set<const bookmarks::BookmarkNode*>& nodes) override;
+  void BookmarkNodeMoved(const BookmarkParentFolder& old_parent,
+                         size_t old_index,
+                         const BookmarkParentFolder& new_parent,
+                         size_t new_index) override;
+  void BookmarkNodeChanged(const bookmarks::BookmarkNode* node) override;
+  void BookmarkNodeFaviconChanged(const bookmarks::BookmarkNode* node) override;
+  void BookmarkParentFolderChildrenReordered(
+      const BookmarkParentFolder& folder) override;
+  void BookmarkAllUserNodesRemoved() override;
+
+ private:
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override;
+
+  void Rebuild();
+  void RebuildIfBar(const BookmarkParentFolder& folder);
+  void RebuildIfInBar(const bookmarks::BookmarkNode* node);
+  std::unique_ptr<views::Button> CreateButton(
+      const bookmarks::BookmarkNode* node);
+  void OpenBookmark(const bookmarks::BookmarkNode* node,
+                    const ui::Event& event);
+  void ShowFolderMenu(views::Button* button,
+                      const bookmarks::BookmarkNode* folder);
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<BookmarkMergedSurfaceService> service_;
+  raw_ptr<views::FlexLayout> layout_ = nullptr;
+  std::unique_ptr<BookmarkContextMenu> context_menu_;
+
+  base::ScopedObservation<BookmarkMergedSurfaceService,
+                          BookmarkMergedSurfaceServiceObserver>
+      service_observation_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TOOLBAR_TOOLBAR_BOOKMARKS_CONTAINER_H_
