@@ -0,0 +1,114 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/helium/adaptive_tab_color.h"
+
+#include <optional>
+
+#include "base/time/time.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/ui_features.h"
+#include "chrome/browser/ui/views/frame/browser_widget.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/color_utils.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr base::TimeDelta kUpdateDelay = base::Milliseconds(100);
+
+constexpr SkColor kTextOnDark = SkColorSetRGB(0xC6, 0xC6, 0xC6);
+constexpr SkColor kTextOnLight = SkColorSetRGB(0x47, 0x47, 0x47);
+
+constexpr size_t kMaxColorsPerTab = 64;
+
+SkColor Quantize(SkColor color) {
+  const auto level = [](unsigned c) { return (c >> 3) * 255 / 31; };
+  return SkColorSetRGB(level(SkColorGetR(color)), level(SkColorGetG(color)),
+                       level(SkColorGetB(color)));
+}
+
+}  // namespace
+
+AdaptiveTabColor::AdaptiveTabColor(BrowserWidget* widget,
+                                   TabStripModel* tab_strip_model)
+    : widget_(widget) {
+  tab_strip_model->AddObserver(this);
+  Observe(tab_strip_model->GetActiveWebContents());
+  Update();
+}
+
+AdaptiveTabColor::~AdaptiveTabColor() = default;
+
+void AdaptiveTabColor::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed()) {
+    Observe(selection.new_contents);
+    colors_seen_.clear();
+    Update();
+  }
+}
+
+void AdaptiveTabColor::PrimaryPageChanged(content::Page& page) {
+  colors_seen_.clear();
+  if (!CanAdapt()) {
+    Update();
+  }
+}
+
+void AdaptiveTabColor::DidFirstVisuallyNonEmptyPaint() {
+  ScheduleUpdate();
+}
+
+void AdaptiveTabColor::DidStopLoading() {
+  ScheduleUpdate();
+}
+
+void AdaptiveTabColor::DidChangeThemeColor() {
+  ScheduleUpdate();
+}
+
+void AdaptiveTabColor::OnBackgroundColorChanged() {
+  ScheduleUpdate();
+}
+
+bool AdaptiveTabColor::CanAdapt() const {
+  return web_contents() &&
+         web_contents()->GetLastCommittedURL().SchemeIsHTTPOrHTTPS();
+}
+
+void AdaptiveTabColor::ScheduleUpdate() {
+  update_timer_.Start(FROM_HERE, kUpdateDelay, this, &AdaptiveTabColor::Update);
+}
+
+void AdaptiveTabColor::Update() {
+  update_timer_.Stop();
+
+  std::optional<SkColor> color;
+  if (CanAdapt()) {
+    color = web_contents()->GetThemeColor();
+    if (!color) {
+      color = web_contents()->GetBackgroundColor();
+    }
+  }
+  if (color) {
+    color = Quantize(SkColorSetA(*color, SK_AlphaOPAQUE));
+    color = color_utils::BlendForMinContrast(
+                *color, color_utils::IsDark(*color) ? kTextOnDark : kTextOnLight,
+                std::nullopt,
+                static_cast<float>(
+                    features::kHeliumAdaptiveTabColorMinContrast.Get()))
+                .color;
+    if (!colors_seen_.contains(*color)) {
+      if (colors_seen_.size() >= kMaxColorsPerTab) {
+        return;
+      }
+      colors_seen_.insert(*color);
+    }
+  }
+  widget_->SetAdaptiveColor(color);
+}
